# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it holds real credentials.

# Neon (PostgreSQL) connection string, from the Neon dashboard.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Neo4j AuraDB Free, from the credentials file AuraDB downloads on creation.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# Aura instance id for newer instances. Leave blank to use the default database.
NEO4J_DATABASE=

# Secret used to sign the session JWT. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
