// Eirene — ER diagram source (DBML)
//
// Paste into https://dbdiagram.io to render, then export the PNG to
// docs/er-diagram.png.
//
// 15 tables:  Person A owns 7 (users, injuries, user_injuries, exercises,
// exercise_injuries, workout_logs, progress_logs); Person B owns 8 (goals,
// allergens, user_allergies, ingredients, ingredient_parts, foods,
// food_ingredients, meal_logs).
//
// Create order note: users.goal_id references goals, which is Person B's
// table. Rather than forcing one person's section of schema.sql to come
// first, the constraint is added at the end of the file:
//
//   ALTER TABLE users
//     ADD CONSTRAINT fk_users_goal
//     FOREIGN KEY (goal_id) REFERENCES goals(goal_id) ON DELETE SET NULL;
//
// That keeps both sections independent of each other's create order.

// ============================================================
// Person A — Training & Users
// ============================================================

Table users {
  user_id        serial       [pk]
  email          varchar(255) [not null, unique]
  password_hash  varchar(255) [not null]
  full_name      varchar(120) [not null]
  role           varchar(10)  [not null, default: 'user', note: "CHECK (role IN ('admin','user'))"]
  goal_id        int          [ref: > goals.goal_id, note: 'ON DELETE SET NULL']
  height_cm      int          [note: 'added by ALTER TABLE; CHECK (height_cm > 0)']
  last_workout_on date        [note: 'maintained by procedure log_workout']
  created_at     timestamptz  [not null, default: `now()`]

  indexes {
    email [unique]
  }
}

Table injuries {
  injury_id   serial       [pk]
  name        varchar(80)  [not null, unique]
  body_part   varchar(60)  [not null]
  description text
}

// Link table: a user has many injuries, an injury affects many users.
Table user_injuries {
  user_id   int  [pk, ref: > users.user_id, note: 'ON DELETE CASCADE']
  injury_id int  [pk, ref: > injuries.injury_id, note: 'ON DELETE CASCADE']
  noted_on  date [not null, default: `current_date`]
  severity  varchar(10) [note: "CHECK (severity IN ('mild','moderate','severe'))"]
}

Table exercises {
  exercise_id  serial       [pk]
  name         varchar(120) [not null, unique]
  muscle_group varchar(60)  [not null]
  equipment    varchar(60)
  difficulty   varchar(12)  [note: "CHECK (difficulty IN ('beginner','intermediate','advanced'))"]
}

// Link table: which exercise strains which injury. Drives the safety trigger
// and the STRAINS edge in Neo4j.
Table exercise_injuries {
  exercise_id int [pk, ref: > exercises.exercise_id, note: 'ON DELETE CASCADE']
  injury_id   int [pk, ref: > injuries.injury_id, note: 'ON DELETE CASCADE']
}

Table workout_logs {
  log_id      serial  [pk]
  user_id     int     [not null, ref: > users.user_id, note: 'ON DELETE CASCADE']
  exercise_id int     [not null, ref: > exercises.exercise_id]
  sets        int     [not null, note: 'CHECK (sets > 0)']
  reps        int     [not null, note: 'CHECK (reps > 0)']
  weight_kg   numeric(6,2) [not null, default: 0, note: 'CHECK (weight_kg >= 0)']
  logged_on   date    [not null, default: `current_date`]
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (user_id, logged_on)
  }
}

Table progress_logs {
  progress_id  serial [pk]
  user_id      int    [not null, ref: > users.user_id, note: 'ON DELETE CASCADE']
  logged_on    date   [not null, default: `current_date`]
  weight_kg    numeric(5,2) [not null, note: 'CHECK (weight_kg BETWEEN 20 AND 400)']
  body_fat_pct numeric(4,1) [note: 'CHECK (body_fat_pct BETWEEN 1 AND 70)']
  notes        text

  indexes {
    (user_id, logged_on) [unique, note: 'one weigh-in per user per day']
  }
}

// ============================================================
// Person B — Nutrition & Recommendations
// ============================================================

Table goals {
  goal_id     serial      [pk]
  name        varchar(60) [not null, unique]
  description text
}

Table allergens {
  allergen_id serial      [pk]
  name        varchar(60) [not null, unique]
}

Table user_allergies {
  user_id     int  [pk, ref: > users.user_id, note: 'ON DELETE CASCADE']
  allergen_id int  [pk, ref: > allergens.allergen_id, note: 'ON DELETE CASCADE']
  severity    varchar(10) [note: "CHECK (severity IN ('mild','moderate','severe'))"]
  noted_on    date [not null, default: `current_date`]
}

Table ingredients {
  ingredient_id serial       [pk]
  name          varchar(120) [not null, unique]
  allergen_id   int          [ref: > allergens.allergen_id, note: 'nullable: most ingredients are not an allergen']
}

// Self-referencing link table: an ingredient can be made of other
// ingredients (satay sauce -> peanut butter -> peanut). Walked by the
// recursive CTE and by CONTAINS*1.. in Neo4j.
Table ingredient_parts {
  parent_id int [pk, ref: > ingredients.ingredient_id, note: 'ON DELETE CASCADE']
  child_id  int [pk, ref: > ingredients.ingredient_id, note: 'ON DELETE CASCADE']
  note      varchar(120) [note: 'CHECK (parent_id <> child_id)']
}

Table foods {
  food_id   serial       [pk]
  name      varchar(120) [not null, unique]
  calories  numeric(7,2) [not null, note: 'CHECK (calories >= 0)']
  protein_g numeric(6,2) [note: 'CHECK (protein_g >= 0)']
  carbs_g   numeric(6,2) [note: 'CHECK (carbs_g >= 0)']
  fat_g     numeric(6,2) [note: 'CHECK (fat_g >= 0)']
}

Table food_ingredients {
  food_id       int [pk, ref: > foods.food_id, note: 'ON DELETE CASCADE']
  ingredient_id int [pk, ref: > ingredients.ingredient_id, note: 'ON DELETE CASCADE']
  quantity_g    numeric(7,2) [note: 'CHECK (quantity_g > 0)']
}

Table meal_logs {
  meal_log_id serial [pk]
  user_id     int    [not null, ref: > users.user_id, note: 'ON DELETE CASCADE']
  food_id     int    [not null, ref: > foods.food_id]
  servings    numeric(5,2) [not null, default: 1, note: 'CHECK (servings > 0)']
  meal_type   varchar(12)  [note: "CHECK (meal_type IN ('breakfast','lunch','dinner','snack'))"]
  logged_on   date   [not null, default: `current_date`]
  created_at  timestamptz [not null, default: `now()`]

  indexes {
    (user_id, logged_on)
  }
}
